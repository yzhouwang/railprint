{
  "name": "railprint",
  "version": "0.11.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "svelte-check --tsconfig ./tsconfig.json && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "sync:railnet": "node scripts/sync-railnet.mjs",
    "sync:railnet:check": "node scripts/sync-railnet.mjs --check",
    "verify:rail": "node scripts/verify-rail.mjs",
    "test": "npm run check && vitest run",
    "test:app": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "dexie": "^4.0.11",
    "maplibre-gl": "^5.0.0",
    "wanakana": "^5.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@tsconfig/svelte": "^5.0.4",
    "@types/geojson": "^7946.0.14",
    "@types/node": "^24.13.2",
    "fake-indexeddb": "^6.0.0",
    "jsdom": "^25.0.1",
    "svelte": "^5.19.0",
    "svelte-check": "^4.1.4",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.0.4"
  }
}
