{
  "name": "railprint",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "An open-source map of every train you've ridden — Japan-first, China-ready.",
  "scripts": {
    "dev": "vite",
    "build": "svelte-check --tsconfig ./tsconfig.json && vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:geometry": "node --test tests/geometry/*.test.ts"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@tsconfig/svelte": "^5.0.4",
    "@types/geojson": "^7946.0.14",
    "fake-indexeddb": "^6.0.0",
    "jsdom": "^25.0.1",
    "svelte": "^5.19.0",
    "svelte-check": "^4.1.4",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "vitest": "^3.0.4"
  },
  "dependencies": {
    "dexie": "^4.0.11",
    "maplibre-gl": "^5.0.0",
    "pmtiles": "^4.1.0"
  }
}
