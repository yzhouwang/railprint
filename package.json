{
  "name": "railprint",
  "version": "0.10.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "svelte-check --tsconfig ./tsconfig.json && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "build:rail-geo:fixture": "node pipeline/cli.ts --input rail-geo/fixtures/jp-toy-input.json --out rail-geo/generated",
    "build:rail-geo:jp": "node pipeline/build-jp.ts --out public/rail/jp-2025.json && node pipeline/build-manifest.ts",
    "build:manifest": "node pipeline/build-manifest.ts",
    "verify:rail-geo:jp": "node pipeline/verify-jp.ts",
    "test": "node --test tests/geometry/*.test.ts && node pipeline/verify-jp.ts && vitest run",
    "test:geometry": "node --test tests/geometry/*.test.ts",
    "test:app": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "build:rail-geo:cn": "node pipeline/build-cn.ts --out public/rail/cn-jinghu-2025.json",
    "build:rail-geo": "npm run build:rail-geo:jp && npm run build:rail-geo:cn && npm run build:manifest"
  },
  "dependencies": {
    "dexie": "^4.0.11",
    "maplibre-gl": "^5.0.0",
    "pmtiles": "^4.1.0",
    "wanakana": "^5.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@tsconfig/svelte": "^5.0.4",
    "@types/geojson": "^7946.0.14",
    "fake-indexeddb": "^6.0.0",
    "jsdom": "^25.0.1",
    "svelte": "^5.19.0",
    "svelte-check": "^4.1.4",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.0.4"
  }
}
